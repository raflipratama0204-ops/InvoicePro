rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya izinkan pemilik akun yang sudah login (UID cocok) mengakses data tokonya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tolak seluruh akses ke dokumen/koleksi lain secara eksplisit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
